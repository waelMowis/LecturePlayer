<?xml version="1.0" encoding="utf-8"?>
<!--
  بروفايل النشر «GitHub»: نفس «Installer» (مثبّت في Releases)، وكمان بيعمل Release على GitHub ويرفع المثبّت،
  فكل الأجهزة اللي عليها البرنامج تشوف «فيه تحديث» وتحدّث لوحدها.

  مرة واحدة قبل أول استخدام:
    1) اكتب المستودع في LecturePlayer.csproj:  <LpGitHubRepo>owner/repo</LpGitHubRepo>  (لازم Public)
    2) winget install GitHub.cli   ثم   gh auth login
  قبل كل نشر (اختياري): اكتب الجديد في ReleaseNotes.md جنب المشروع، وبيظهر للمستخدمين في رسالة التحديث.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishProtocol>FileSystem</PublishProtocol>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- مش ملف واحد: مكتبات VLC الأصلية لازم تفضل فولدرات جنب البرنامج -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\Releases\_staging\</PublishDir>
    <LpRelease>true</LpRelease>
    <LpGitHubPublish>true</LpGitHubPublish>
  </PropertyGroup>
</Project>
