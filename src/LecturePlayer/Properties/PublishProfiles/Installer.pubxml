<?xml version="1.0" encoding="utf-8"?>
<!--
  بروفايل النشر «Installer»: كل Publish بيطلع مثبّت جديد برقم جديد في فولدر Releases جنب المشروع:

    E:\PLAYER\LecturePlayer\Releases\
        LecturePlayer-Setup-4.0.3.exe
        LecturePlayer-Setup-4.0.4.exe
        ...

  الملف ده هو كل اللي تنقله لأي جهاز (مش محتاج .NET ولا VLC).

  الملف ده متعمد يكون بسيط ومايعتمدش على أي حاجة في الـ csproj
  (Visual Studio بيقراه لوحده وقت الـ restore). كل المنطق في LecturePlayer.csproj.

  من سطر الأوامر:   dotnet publish src\LecturePlayer -p:PublishProfile=Installer
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishProtocol>FileSystem</PublishProtocol>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- مش ملف واحد: مكتبات VLC الأصلية لازم تفضل فولدرات جنب البرنامج -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\Releases\_staging\</PublishDir>
    <LpRelease>true</LpRelease>
  </PropertyGroup>
</Project>
