<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041 عشان محرك OCR بتاع الويندوز (Windows.Media.Ocr) -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LecturePlayer</RootNamespace>
    <AssemblyName>LecturePlayer</AssemblyName>
    <ApplicationIcon>LecturePlayer.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationDefaultFont>Segoe UI, 9.75pt</ApplicationDefaultFont>
    <Product>مسار</Product>
    <!-- بيظهروا في خصائص الملف (Properties ← Details) وفي «عن البرنامج» -->
    <Authors>د. وائل عويس (Dr. Wael Owais)</Authors>
    <Company>د. وائل عويس</Company>
    <Copyright>© 2026 د. وائل عويس — جميع الحقوق محفوظة</Copyright>
    <Description>مسار (Masar) — مكتبة فيديو منظّمة بتكمّل من حيث وقفت. تطوير د. وائل عويس</Description>
    <!-- أول رقمين من الإصدار. التالت = رقم النشر الرسمي على GitHub (شوف LpStampVersion تحت) -->
    <LpBaseVersion>4.1</LpBaseVersion>
    <Version>$(LpBaseVersion).0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- عشان الـ restore العادي يجهّز win-x64 كمان، والنشر مايحتاجش restore لوحده -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <LpRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))</LpRoot>
    <LpReleasesRoot>$(LpRoot)\Releases</LpReleasesRoot>

    <!-- مستودع GitHub (owner/repo): البرنامج بيدوّر فيه على التحديثات (.github/workflows/release.yml بينشر عليه).
         لازم يكون Public عشان أجهزة المستخدمين تقدر تنزّل منه. -->
    <LpGitHubRepo>waelMowis/LecturePlayer</LpGitHubRepo>
  </PropertyGroup>

  <ItemGroup>
    <!-- محرك التشغيل: VLC (يشغل mp4 / mkv / avi / ... أي صيغة) -->
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.*" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.*" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- GeneratePathProperty: بيدينا $(PkgVideoLAN_LibVLC_Windows) = مكان الباكدج، عشان خطوة النشر تتأكد إن مكتبات VLC اتنسخت -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.*" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup Condition="'$(LpGitHubRepo)' != ''">
    <!-- بيتكتب جوه البرنامج: UpdateChecker.BuiltInRepo -->
    <AssemblyMetadata Include="UpdateRepo" Value="$(LpGitHubRepo)" />
  </ItemGroup>

  <ItemGroup>
    <!-- الأيقونة جوه البرنامج نفسه (للشبابيك وأيقونة جنب الساعة) -->
    <EmbeddedResource Include="LecturePlayer.ico" LogicalName="LecturePlayer.ico" />
    <!-- دليل الاستخدام (مساعدة ← دليل الاستخدام / F1) -->
    <EmbeddedResource Include="Help\Guide.html" LogicalName="Guide.html" />
  </ItemGroup>

  <ItemGroup>
    <!-- قارئ الكتب: PDF.js (Apache-2.0) وصفحة القارئ — بيتنسخوا جنب البرنامج (فولدر Reader) -->
    <Content Include="Reader\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- =====================================================================
       أرقام الإصدارات — مصدر واحد بس: GitHub
         • النشر الرسمي (GitHub Actions ← release.yml): الإصدار = LpBaseVersion + رقم تشغيل النشر (4.1.8، 4.1.9 …)
           ودي الإصدارات اللي الأجهزة بتتحدّث منها.
         • النشر من Visual Studio (بروفايل Installer): مثبّت للتجربة على جهازك بس. رقمه LpBaseVersion.0 (أقل من
           أي إصدار رسمي، فالبرنامج المتثبت منه بيعرض التحديث للإصدار الرسمي على طول)، واسمه فيه التاريخ والساعة
           عشان مايتلخبطش مع الإصدارات الرسمية: Masar-Setup-test-20261114-1130.exe
       ===================================================================== -->
  <Target Name="LpStampVersion" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;Publish" Condition="'$(LpRelease)' == 'true'">
    <PropertyGroup>
      <LpOfficial Condition="'$(LpBuildNumberOverride)' != ''">true</LpOfficial>
      <LpBuildNumber Condition="'$(LpOfficial)' == 'true'">$(LpBuildNumberOverride)</LpBuildNumber>
      <LpBuildNumber Condition="'$(LpOfficial)' != 'true'">0</LpBuildNumber>
      <LpStamp>$([System.DateTime]::Now.ToString("yyyyMMdd-HHmm"))</LpStamp>
      <Version>$(LpBaseVersion).$(LpBuildNumber)</Version>
      <AssemblyVersion>$(Version).0</AssemblyVersion>
      <FileVersion>$(Version).0</FileVersion>
      <InformationalVersion Condition="'$(LpOfficial)' == 'true'">$(Version)</InformationalVersion>
      <InformationalVersion Condition="'$(LpOfficial)' != 'true'">$(Version)-test.$(LpStamp)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <!-- مكتبات VLC الأصلية (libvlc\win-x64): لو النشر مانسخهاش، ننسخها إحنا، ولو مالقيناهاش النشر يفشل بدل ما يطلع مثبّت بايظ -->
  <Target Name="LpEnsureLibVlc">
    <PropertyGroup>
      <LpStaging>$([System.IO.Path]::GetFullPath('$(PublishDir)').TrimEnd('\').TrimEnd('/'))</LpStaging>
      <LpVlcOut>$(LpStaging)\libvlc\win-x64\</LpVlcOut>
      <LpVlcPkg>$(PkgVideoLAN_LibVLC_Windows)</LpVlcPkg>
      <LpVlcPkg Condition="'$(LpVlcPkg)' == '' and '$(NuGetPackageRoot)' != ''">$(NuGetPackageRoot)videolan.libvlc.windows</LpVlcPkg>
    </PropertyGroup>

    <!-- 1) من الباكدج -->
    <ItemGroup Condition="!Exists('$(LpVlcOut)libvlc.dll') and '$(LpVlcPkg)' != '' and Exists('$(LpVlcPkg)')">
      <LpVlcDll Include="$(LpVlcPkg)\**\libvlc.dll" />
      <LpVlcDllX64 Include="@(LpVlcDll)" Condition="$([System.String]::Copy('%(FullPath)').Replace('\','/').Contains('/x64/')) or $([System.String]::Copy('%(FullPath)').Replace('\','/').Contains('/win-x64/'))" />
    </ItemGroup>
    <PropertyGroup Condition="'@(LpVlcDllX64)' != ''">
      <LpVlcSrc>%(LpVlcDllX64.RootDir)%(LpVlcDllX64.Directory)</LpVlcSrc>
    </PropertyGroup>
    <!-- 2) أو من مخرجات الـ Build العادي -->
    <PropertyGroup Condition="!Exists('$(LpVlcOut)libvlc.dll') and '$(LpVlcSrc)' == ''">
      <LpVlcSrc Condition="Exists('$(MSBuildProjectDirectory)\bin\Release\$(TargetFramework)\libvlc\win-x64\libvlc.dll')">$(MSBuildProjectDirectory)\bin\Release\$(TargetFramework)\libvlc\win-x64\</LpVlcSrc>
      <LpVlcSrc Condition="'$(LpVlcSrc)' == '' and Exists('$(MSBuildProjectDirectory)\bin\Debug\$(TargetFramework)\libvlc\win-x64\libvlc.dll')">$(MSBuildProjectDirectory)\bin\Debug\$(TargetFramework)\libvlc\win-x64\</LpVlcSrc>
    </PropertyGroup>

    <ItemGroup Condition="'$(LpVlcSrc)' != ''">
      <LpVlcFiles Include="$(LpVlcSrc)**\*" Exclude="$(LpVlcSrc)**\*.lib" />
    </ItemGroup>
    <Copy Condition="'$(LpVlcSrc)' != ''" SourceFiles="@(LpVlcFiles)"
          DestinationFiles="@(LpVlcFiles->'$(LpVlcOut)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Condition="'$(LpVlcSrc)' != ''" Importance="high" Text="نسخت مكتبات VLC من: $(LpVlcSrc)" />
    <Error Condition="!Exists('$(LpVlcOut)libvlc.dll') or !Exists('$(LpVlcOut)libvlccore.dll') or !Exists('$(LpVlcOut)plugins')"
           Text="مكتبات VLC (libvlc\win-x64) مش موجودة في النشر، والمثبّت كان هيطلع بايظ. اعمل Build عادي مرة (Release) وبعدين Publish تاني." />
  </Target>

  <!-- أدوات يوتيوب جوه المثبّت: yt-dlp وDeno بيتنزلوا من GitHub الرسمي وقت النشر (أحدث نسخة)
       وبيتحطوا جنب البرنامج، فالمستخدم مايتطلبش منه ينزّل حاجة أول مرة.
       لو التنزيل فشل (من غير نت مثلًا) بنستخدم آخر نسخة متنزلة، ولو مفيش: تحذير والمثبّت يطلع من غيرهم.
       لإلغاء الدمج: -p:LpBundleTools=false -->
  <Target Name="LpBundleTools" Condition="'$(LpRelease)' == 'true' and '$(LpBundleTools)' != 'false'">
    <PropertyGroup>
      <LpToolsCache>$(LpReleasesRoot)\_tools</LpToolsCache>
      <LpWhisperUrl Condition="'$(LpWhisperUrl)' == ''">https://github.com/ggml-org/whisper.cpp/releases/download/b5454/whisper-bin-x64.zip</LpWhisperUrl>
    </PropertyGroup>
    <RemoveDir Directories="$(LpToolsCache)\new" />

    <DownloadFile SourceUrl="https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp.exe"
                  DestinationFolder="$(LpToolsCache)\new" DestinationFileName="yt-dlp.exe" Retries="2" ContinueOnError="WarnAndContinue">
      <Output TaskParameter="DownloadedFile" ItemName="LpGotYtDlp" />
    </DownloadFile>
    <Copy Condition="'@(LpGotYtDlp)' != ''" SourceFiles="@(LpGotYtDlp)" DestinationFolder="$(LpToolsCache)" />

    <DownloadFile SourceUrl="https://github.com/denoland/deno/releases/latest/download/deno-x86_64-pc-windows-msvc.zip"
                  DestinationFolder="$(LpToolsCache)\new" DestinationFileName="deno.zip" Retries="2" ContinueOnError="WarnAndContinue">
      <Output TaskParameter="DownloadedFile" ItemName="LpGotDeno" />
    </DownloadFile>
    <Unzip Condition="'@(LpGotDeno)' != ''" SourceFiles="@(LpGotDeno)" DestinationFolder="$(LpToolsCache)" OverwriteReadOnlyFiles="true" ContinueOnError="WarnAndContinue" />
    <!-- أداة تحويل الكلام لنص (whisper.cpp): آخر إصدارات v1.9.x مفيهاش ملفات ويندوز، فبنثبّت إصدار فيه الملف -->
    <DownloadFile SourceUrl="$(LpWhisperUrl)"
                  DestinationFolder="$(LpToolsCache)\new" DestinationFileName="whisper.zip" Retries="3" ContinueOnError="WarnAndContinue">
      <Output TaskParameter="DownloadedFile" ItemName="LpGotWhisper" />
    </DownloadFile>
    <RemoveDir Condition="'@(LpGotWhisper)' != ''" Directories="$(LpToolsCache)\whisper-raw;$(LpToolsCache)\whisper" />
    <Unzip Condition="'@(LpGotWhisper)' != ''" SourceFiles="@(LpGotWhisper)" DestinationFolder="$(LpToolsCache)\whisper-raw" OverwriteReadOnlyFiles="true" ContinueOnError="WarnAndContinue" />
    <ItemGroup>
      <LpWhisperFiles Include="$(LpToolsCache)\whisper-raw\**\*.exe;$(LpToolsCache)\whisper-raw\**\*.dll" />
    </ItemGroup>
    <Copy Condition="'@(LpWhisperFiles)' != ''" SourceFiles="@(LpWhisperFiles)" DestinationFolder="$(LpToolsCache)\whisper" />
    <RemoveDir Directories="$(LpToolsCache)\new;$(LpToolsCache)\whisper-raw" />
    <ItemGroup>
      <LpWhisperReady Include="$(LpToolsCache)\whisper\*.*" />
    </ItemGroup>
    <Copy Condition="Exists('$(LpToolsCache)\whisper\whisper-cli.exe')" SourceFiles="@(LpWhisperReady)" DestinationFolder="$(LpStaging)\whisper" />
    <Error Condition="!Exists('$(LpStaging)\whisper\whisper-cli.exe')"
           Text="أداة تحويل الكلام لنص (whisper-cli.exe) ماتضافتش للمثبّت — الرابط: $(LpWhisperUrl)" />
    <Message Importance="high" Text="✓ أداة تحويل الكلام لنص (whisper) اتضافت للمثبّت" />

    <Copy Condition="Exists('$(LpToolsCache)\yt-dlp.exe')" SourceFiles="$(LpToolsCache)\yt-dlp.exe" DestinationFolder="$(LpStaging)" />
    <Copy Condition="Exists('$(LpToolsCache)\deno.exe')" SourceFiles="$(LpToolsCache)\deno.exe" DestinationFolder="$(LpStaging)" />
    <Copy SourceFiles="$(LpRoot)\installer\THIRD-PARTY-NOTICES.txt" DestinationFolder="$(LpStaging)" Condition="Exists('$(LpRoot)\installer\THIRD-PARTY-NOTICES.txt')" />

    <Message Condition="Exists('$(LpStaging)\yt-dlp.exe') and Exists('$(LpStaging)\deno.exe')" Importance="high" Text="✓ أدوات يوتيوب (yt-dlp + Deno) اتضافت للمثبّت" />
    <Warning Condition="!Exists('$(LpStaging)\yt-dlp.exe') or !Exists('$(LpStaging)\deno.exe')"
             Text="مقدرتش أجيب أدوات يوتيوب (yt-dlp / Deno) للمثبّت، فالبرنامج هيطلب ينزّلهم أول مرة زي الأول." />
  </Target>

  <Target Name="LpRelease" AfterTargets="Publish" DependsOnTargets="LpStampVersion;LpEnsureLibVlc;LpBundleTools" Condition="'$(LpRelease)' == 'true'">
    <PropertyGroup>
      <LpIss>$(LpRoot)\installer\LecturePlayer.iss</LpIss>
      <LpSetupName Condition="'$(LpOfficial)' == 'true'">Masar-Setup-$(Version)</LpSetupName>
      <LpSetupName Condition="'$(LpOfficial)' != 'true'">Masar-Setup-test-$(LpStamp)</LpSetupName>

      <!-- مكان ISCC.exe: ممكن تحدده بنفسك بـ -p:LpIscc=... -->
      <LpIscc Condition="'$(LpIscc)' == '' and Exists('$(MSBuildProgramFiles32)\Inno Setup 6\ISCC.exe')">$(MSBuildProgramFiles32)\Inno Setup 6\ISCC.exe</LpIscc>
      <LpIscc Condition="'$(LpIscc)' == '' and Exists('$(ProgramW6432)\Inno Setup 6\ISCC.exe')">$(ProgramW6432)\Inno Setup 6\ISCC.exe</LpIscc>
      <LpIscc Condition="'$(LpIscc)' == '' and Exists('$(LOCALAPPDATA)\Programs\Inno Setup 6\ISCC.exe')">$(LOCALAPPDATA)\Programs\Inno Setup 6\ISCC.exe</LpIscc>
      <LpIscc Condition="'$(LpIscc)' == '' and Exists('$(ProgramW6432)\Inno Setup 7\ISCC.exe')">$(ProgramW6432)\Inno Setup 7\ISCC.exe</LpIscc>
      <LpIscc Condition="'$(LpIscc)' == '' and Exists('$(MSBuildProgramFiles32)\Inno Setup 7\ISCC.exe')">$(MSBuildProgramFiles32)\Inno Setup 7\ISCC.exe</LpIscc>
    </PropertyGroup>

    <Error Condition="'$(LpIscc)' == ''"
           Text="Inno Setup مش متثبت، فالمثبّت ماتعملش. نزّله من jrsoftware.org أو: winget install JRSoftware.InnoSetup" />

    <!-- تنضيف ملفات النشر قبل التغليف:
         باكدج VLC بينسخ x86 و arm64 كمان (~200 ميجا زيادة) والبرنامج 64 بت بس، وملفات .lib مش لازمة للتشغيل،
         وفولدر Data (لو حد شغّل البرنامج من هنا) مايدخلش المثبّت أبدًا -->
    <ItemGroup>
      <LpLibFiles Include="$(LpStaging)\libvlc\**\*.lib" />
    </ItemGroup>
    <RemoveDir Directories="$(LpStaging)\libvlc\win-x86;$(LpStaging)\libvlc\win-arm64;$(LpStaging)\Data" />
    <Delete Files="@(LpLibFiles)" />

    <!-- المثبّت: ملف واحد في Releases -->
    <MakeDir Directories="$(LpReleasesRoot)" />
    <Exec Command="&quot;$(LpIscc)&quot; /Q &quot;/DSourceDir=$(LpStaging)&quot; &quot;/DAppVersion=$(Version)&quot; &quot;/O$(LpReleasesRoot)&quot; &quot;/F$(LpSetupName)&quot; &quot;$(LpIss)&quot;" />

    <!-- ملفات النشر المؤقتة مالهاش لازمة بعد كده -->
    <RemoveDir Directories="$(LpStaging)" />

    <Message Importance="high" Text="✓ المثبّت جاهز: $(LpReleasesRoot)\$(LpSetupName).exe" />
  </Target>

</Project>
